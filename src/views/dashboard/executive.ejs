<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
  <meta charset="UTF-8" />
  <title>Sanad Review - Executive Dashboard</title>
  <link rel="stylesheet" href="/style.css" />
</head>
<body>
  <header class="topbar">
    <h1>Sanad Review</h1>
    <nav class="nav-links">
      <a href="/dashboard">Dashboard</a>
      <a href="/settings">Settings</a>
      <a href="/billing">Subscription</a>
      <form method="POST" action="/logout" style="display:inline">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
        <button class="link-btn" type="submit">Log out</button>
      </form>
    </nav>
  </header>

  <div class="container">
    <div class="exec-header">
      <div>
        <h2>🧭 Executive Dashboard</h2>
        <p class="muted small">Your operational advisor — turns raw reviews into decisions you can act on today.</p>
      </div>
      <% if (accounts.length > 1) { %>
        <form method="GET" action="/executive" class="exec-picker">
          <select name="accountId" onchange="this.form.submit()">
            <option value="">All businesses (combined)</option>
            <% accounts.forEach(function(a) { %>
              <option value="<%= a.id %>" <%= selectedAccountId === a.id ? 'selected' : '' %>><%= a.business_name %></option>
            <% }) %>
          </select>
        </form>
      <% } %>
    </div>

    <% if (!accounts.length) { %>
      <section class="card-block">
        <p>Connect and activate a business first to see your executive dashboard.</p>
        <a class="btn" href="/dashboard">Go to Dashboard</a>
      </section>
    <% } else { %>

      <% if (earlyWarning && earlyWarning.triggered) { %>
        <section class="exec-warning">
          <div class="exec-warning-icon">⚠️</div>
          <div>
            <strong>Early warning — rating risk detected</strong>
            <p>
              In the last 14 days, the average rating is
              <strong><%= earlyWarning.recentAvg %>★</strong> vs
              <strong><%= earlyWarning.priorAvg %>★</strong> in the 14 days before
              (<%= earlyWarning.ratingDrop > 0 ? `-${earlyWarning.ratingDrop}` : earlyWarning.ratingDrop %>).
              <% if (earlyWarning.risingIssue) { %>
                Complaints mentioning "<strong><%= earlyWarning.risingIssue %></strong>" are rising faster than usual.
              <% } %>
              This is a rule-based early signal, not a guarantee — worth a closer look before it shows up in your public rating.
            </p>
          </div>
        </section>
      <% } %>

      <section class="stats-row">
        <div class="stat-tile exec-satisfaction">
          <div class="stat-value">
            <% if (satisfaction && satisfaction.score != null) { %>
              <%= satisfaction.score %>%
            <% } else { %>
              —
            <% } %>
          </div>
          <div class="stat-label">Satisfaction (4-5★ share, last <%= satisfaction ? satisfaction.windowDays : 90 %> days)</div>
          <% if (satisfaction && satisfaction.delta != null) { %>
            <div class="exec-delta <%= satisfaction.delta >= 0 ? 'up' : 'down' %>">
              <%= satisfaction.delta >= 0 ? '▲' : '▼' %> <%= Math.abs(satisfaction.delta) %>pt vs previous period
            </div>
          <% } %>
        </div>
        <div class="stat-tile">
          <div class="stat-value"><%= satisfaction ? satisfaction.totalReviews : 0 %></div>
          <div class="stat-label">Reviews analyzed in period</div>
        </div>
      </section>

      <div class="exec-grid">
        <section class="card-block exec-list">
          <h3>🔻 Top Problems</h3>
          <p class="muted small">Most-mentioned complaint themes in 1-3★ reviews with a comment.</p>
          <% if (!topIssues.length) { %>
            <p class="muted">No recurring problems found — either not enough negative reviews yet, or complaints are too varied to rank.</p>
          <% } else { %>
            <ol class="exec-rank-list">
              <% topIssues.forEach(function(item) { %>
                <li><span class="exec-rank-label"><%= item.keyword %></span><span class="exec-rank-count"><%= item.count %></span></li>
              <% }) %>
            </ol>
          <% } %>
        </section>

        <section class="card-block exec-list">
          <h3>💚 Top Loved Items</h3>
          <p class="muted small">Most-mentioned praise themes in 4-5★ reviews with a comment.</p>
          <% if (!topPraises.length) { %>
            <p class="muted">No recurring praise theme found yet — needs more positive reviews with comments.</p>
          <% } else { %>
            <ol class="exec-rank-list">
              <% topPraises.forEach(function(item) { %>
                <li><span class="exec-rank-label"><%= item.keyword %></span><span class="exec-rank-count"><%= item.count %></span></li>
              <% }) %>
            </ol>
          <% } %>
        </section>
      </div>

      <section class="card-block">
        <h3>📍 Nearby Competitor Comparison</h3>
        <% if (competitors.available) { %>
          <% if (!competitors.competitors.length) { %>
            <p class="muted">No comparable nearby businesses found on Google for this category yet.</p>
          <% } else { %>
            <ul class="exec-competitor-list">
              <% competitors.competitors.forEach(function(c) { %>
                <li>
                  <span><%= c.name %></span>
                  <span><%= c.rating != null ? `★ ${c.rating}` : 'No rating' %> <span class="muted small">(<%= c.reviewCount %> reviews)</span></span>
                </li>
              <% }) %>
            </ul>
          <% } %>
        <% } else if (competitors.reason === 'select_a_business' || competitors.reason === 'no_active_business') { %>
          <p class="muted">Select a specific business above to compare it with nearby competitors.</p>
        <% } else if (competitors.reason === 'missing_location') { %>
          <p class="muted">This business is missing location data from Google — reconnect it to enable this comparison.</p>
        <% } else { %>
          <p class="muted">🔒 Not enabled yet — this needs a separate Google Places API key (with billing enabled on the Google Cloud project). Ask your developer to set <code>GOOGLE_PLACES_API_KEY</code> to turn this on.</p>
        <% } %>
      </section>

    <% } %>
  </div>
</body>
</html>
