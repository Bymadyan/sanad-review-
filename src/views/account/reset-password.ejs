<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link rel="icon" type="image/png" href="/images/favicon-32.png" />
  <title>Reset Password - xrepu</title>
  <link rel="stylesheet" href="/style.css" />
</head>
<body>
  <div class="auth-shell">
    <div class="login-box">
      <a href="/" class="brand-mark-link"><img src="/images/logo.png" alt="xrepu" class="brand-mark-img" /></a>
      <p>Choose a new password</p>
      <% if (error) { %>
        <p class="error"><%= error %></p>
      <% } %>
      <form method="POST" action="/reset-password">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
        <input type="hidden" name="token" value="<%= token %>" />
        <input type="hidden" name="uid" value="<%= uid %>" />
        <input type="password" name="password" placeholder="New password (min. 8 characters)" minlength="8" required autofocus />
        <button type="submit">Reset Password</button>
      </form>
    </div>
  </div>
</body>
</html>
