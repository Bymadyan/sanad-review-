<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <link rel="icon" type="image/png" href="/images/favicon-32.png" />
  <title>Log In - xrepu</title>
  <link rel="stylesheet" href="/style.css" />
</head>
<body>
  <div class="auth-shell">
    <div class="login-box">
      <a href="/" class="brand-mark-link"><img src="/images/logo.png" alt="xrepu" class="brand-mark-img" /></a>
      <p>Log in to your dashboard</p>
      <% if (error) { %>
        <p class="error"><%= error %></p>
      <% } %>
      <form method="POST" action="/login">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
        <input type="email" name="email" placeholder="Email address" required autofocus />
        <input type="password" name="password" placeholder="Password" required />
        <button type="submit">Log In</button>
      </form>
      <p class="muted small"><a href="/forgot-password">Forgot your password?</a></p>
      <p class="muted small">Don't have an account? <a href="/signup">Sign up</a></p>
    </div>
  </div>
</body>
</html>
