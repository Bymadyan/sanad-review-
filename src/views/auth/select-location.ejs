<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
  <meta charset="UTF-8" />
  <title>Select Business - Sanad Review</title>
  <link rel="stylesheet" href="/style.css" />
</head>
<body>
  <div class="container">
    <h1>Choose the business you'd like to connect</h1>
    <% if (!locationsByAccount.length || locationsByAccount.every(a => !a.locations.length)) { %>
      <p class="error">We couldn't find any business linked to this Google account. Make sure you're an owner or manager of the Google Business Profile.</p>
    <% } %>
    <% locationsByAccount.forEach(function(entry) { %>
      <% entry.locations.forEach(function(loc) { %>
        <form method="POST" action="/auth/select-location" class="location-card">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
          <input type="hidden" name="locationName" value="<%= loc.name %>" />
          <input type="hidden" name="businessName" value="<%= loc.title %>" />
          <input type="hidden" name="reviewLink" value="<%= (loc.metadata && loc.metadata.newReviewUri) || '' %>" />
          <div>
            <strong><%= loc.title %></strong>
            <% if (loc.storefrontAddress) { %>
              <div class="muted"><%= [loc.storefrontAddress.addressLines, loc.storefrontAddress.locality].flat().filter(Boolean).join(', ') %></div>
            <% } %>
          </div>
          <button class="btn" type="submit">Connect this business</button>
        </form>
      <% }) %>
    <% }) %>
    <p><a href="/dashboard">Back to dashboard</a></p>
  </div>
</body>
</html>
