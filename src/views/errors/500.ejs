<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
  <meta charset="UTF-8" />
  <title>Something Went Wrong - xrepu</title>
  <link rel="stylesheet" href="/style.css" />
</head>
<body>
  <div class="error-shell">
    <div>
      <div class="code">500</div>
      <h1>Something went wrong</h1>
      <p class="muted">We've logged the error and will look into it. Please try again in a moment.</p>
      <% if (message) { %><pre class="muted small" style="text-align: left; max-width: 600px; margin: 16px auto; white-space: pre-wrap;"><%= message %></pre><% } %>
      <p><a href="/" class="btn">Go home</a></p>
    </div>
  </div>
</body>
</html>
