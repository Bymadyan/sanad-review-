<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
  <meta charset="UTF-8" />
  <title>Subscription - Sanad Review</title>
  <link rel="stylesheet" href="/style.css" />
</head>
<body>
  <header class="topbar">
    <h1>Sanad Review</h1>
    <nav class="nav-links">
      <% if (typeof urgentReviewCount !== 'undefined' && urgentReviewCount > 0) { %>
        <a href="/dashboard?status=needs_reply" class="urgent-badge-link">🚨 <%= urgentReviewCount %> urgent</a>
      <% } %>
      <a href="/dashboard">Dashboard</a>
      <a href="/settings">Settings</a>
      <form method="POST" action="/logout" style="display:inline">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
        <button class="link-btn" type="submit">Log out</button>
      </form>
    </nav>
  </header>

  <div class="container narrow">
    <div class="accounts">
      <h2>Subscription</h2>
      <p class="muted">Each connected business has its own $35/month subscription — add as many businesses as you like and pay only for the ones you activate.</p>

      <% if (!stripeConfigured) { %>
        <p class="error">Payments aren't enabled yet. Please contact us.</p>
      <% } %>

      <% if (!accounts.length) { %>
        <p>You haven't connected any business yet.</p>
        <a class="btn" href="/auth/google">+ Connect Google Business Profile</a>
      <% } else { %>
        <ul class="billing-list">
          <% accounts.forEach(function(a) { %>
            <% var isActive = activeStatuses.has(a.sub_status); %>
            <li class="billing-item">
              <div>
                <strong><%= a.business_name %></strong>
                <% if (isActive) { %>
                  <span class="badge published">Active ✅</span>
                  <p class="muted small">Next renewal: <%= a.sub_period_end ? new Date(a.sub_period_end * 1000).toLocaleDateString('en-US') : '-' %></p>
                <% } else { %>
                  <span class="badge"><%= a.sub_status && a.sub_status !== 'incomplete' ? a.sub_status : 'Needs payment' %></span>
                  <form method="POST" action="/billing/<%= a.id %>/checkout">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
                    <button class="btn btn-pay-black" type="submit">Pay $35/mo</button>
                  </form>
                <% } %>
              </div>
            </li>
          <% }) %>
        </ul>

        <% if (hasStripeCustomer) { %>
          <form method="POST" action="/billing/portal">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
            <button class="btn secondary" type="submit">Manage Subscriptions / Payment Method</button>
          </form>
        <% } %>

        <div class="actions-row">
          <a class="btn secondary" href="/auth/google">+ Connect another business</a>
          <a href="/dashboard">Go to dashboard</a>
        </div>
      <% } %>
    </div>
  </div>
</body>
</html>
