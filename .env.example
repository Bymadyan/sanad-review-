# انسخ هذا الملف باسم .env واملأ القيم (راجع README.md للتفاصيل)

# بيانات اعتماد OAuth من Google Cloud Console
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# لازم تكون نفس الرابط المسجل في Google Cloud Console بالضبط
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# مفتاح عشوائي طويل لتشفير جلسات تسجيل الدخول (أي نص عشوائي طويل)
SESSION_SECRET=change-this-to-a-long-random-string

# منفذ التشغيل المحلي
PORT=3000
NODE_ENV=development

# رابط الموقع الأساسي (يُستخدم في روابط العودة من Stripe وروابط الإيميلات). محلياً اتركه كذا،
# وبعد النشر حطه رابط تطبيقك الحقيقي، مثلاً: https://sanad-review.up.railway.app
APP_BASE_URL=http://localhost:3000

# --- Stripe (نظام الاشتراك الشهري 35$ لكل نشاط تجاري) ---
# من Stripe Dashboard > Developers > API keys. استخدم مفاتيح sk_test_ أثناء التجربة.
STRIPE_SECRET_KEY=
# أنشئ Product باسم Sanad Review وPrice شهري 35.00 USD، وحط معرف الـ Price هنا (يبدأ بـ price_)
STRIPE_PRICE_ID=
# من Stripe Dashboard > Developers > Webhooks بعد ما تضيف endpoint على /billing/webhook
STRIPE_WEBHOOK_SECRET=

# اختياري: إذا حطيت مفتاح Anthropic API هنا، راح تولد الأداة ردود أذكى عبر Claude
# (بأي لغة يكتب فيها العميل) بدل القوالب الجاهزة. لو تركته فاضي، الأداة تشتغل بدون أي تكلفة إضافية.
ANTHROPIC_API_KEY=

# اختياري: يفعّل "مقارنة المنافسين القريبين" باللوحة التنفيذية (/executive). يحتاج تفعيل Places API
# (New) بمشروعك على Google Cloud + تفعيل Billing (فيه رصيد شهري مجاني). بدونه، هذا القسم بس يختفي
# بأمان من اللوحة التنفيذية بدون أي خطأ — كل باقي اللوحة (الرضا، أكثر المشاكل والمحاسن، الإنذار
# المبكر) يشتغل عادي بدونه.
GOOGLE_PLACES_API_KEY=

# اختياري: إشعارات بريدية (تقييم جديد، التقرير الأسبوعي، إعادة تعيين كلمة المرور).
# سجّل حساب مجاني على resend.com وخذ API key من هناك. لو تركته فاضي، الأداة تشتغل عادي بدون إشعارات
# (عدا إعادة تعيين كلمة المرور — تلك الميزة تحتاج RESEND_API_KEY لتعمل).
RESEND_API_KEY=
# البريد اللي يظهر كمرسل. بدون توثيق دومين خاص بك على Resend، اتركه كذا (بريد تجريبي من Resend).
RESEND_FROM_EMAIL=Sanad Review <onboarding@resend.dev>
